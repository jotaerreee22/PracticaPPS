extends layout

block content
  div.container(style="max-width: 400px; margin-top: 100px;")
    form(action="/login", method="POST")
      div.form-group
        label Usuario (Email):
        input(type="email", name="email" required placeholder="admin@app.com")
      div.form-group
        label Contraseña:
        input(type="password", name="pass" required placeholder="******")
      button.btn.btn-primary(type="submit" style="width: 100%;") Ingresar