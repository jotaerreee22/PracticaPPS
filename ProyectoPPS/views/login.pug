extends layout

block content
  div.container(style="max-width: 400px; margin-top: 100px;")
    h2.text-center.mb-4 Iniciar Sesión
    form(action="/login", method="POST")
      div.mb-3
        label.form-label Usuario:
        input.form-control(type="text", name="email" required placeholder="admin o carlos")
      div.mb-3
        label.form-label Contraseña:
        input.form-control(type="password", name="pass" required placeholder="******")
      button.btn.btn-primary.w-100(type="submit") Ingresar