extends layout

block content
  div.container.mt-4
    div.d-flex.justify-content-between.align-items-center.mb-4
      h2 Bienvenido, #{usuario.nombre} (#{usuario.rol})
      a.btn.btn-danger(href="/logout") Cerrar Sesión

    hr

    div.row
      div.col-md-4
        h4 Compañeros / Admin
        ul.list-group
          each comp in companeros
            li.list-group-item= `${comp.nombre} (${comp.rol})`

      div.col-md-8
        h4 Chat General y con Administrador
        div.card.p-3.mb-3(style="height: 300px; overflow-y: scroll; background: #f8f9fa;")
          each m in mensajes
            div.mb-2
              strong= m.remitenteNombre + ": "
              span= m.texto

        form(action="/mensaje/enviar", method="POST")
          div.input-group
            input.form-control(type="text", name="texto", placeholder="Escribe un mensaje...", required)
            button.btn.btn-primary(type="submit") Enviar