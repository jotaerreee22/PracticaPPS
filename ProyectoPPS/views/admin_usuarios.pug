extends layout

block content
  div.container.mt-4
    h2 Panel de Administración - Usuarios
    div.mb-3
      a.btn.btn-secondary.me-2(href="/admin/grupos") Ver Grupos
      a.btn.btn-danger(href="/logout") Cerrar Sesión

    hr

    h3 Lista de Usuarios
    h3.mt-4 Alta de Usuario
 
    form(action="/admin/usuario/alta", method="POST", enctype="multipart/form-data")
      div.mb-3
        label.form-label Nombre completo
        input.form-control(type="text", name="nombre", required)
 
      div.mb-3
        label.form-label Nombre de usuario
        input.form-control(type="text", name="email", required)
 
      div.mb-3
        label.form-label Contraseña
        input.form-control(type="password", name="pass", required, minlength="8")
 
      div.mb-3
        label.form-label Asignar grupo
        select.form-select(name="grupoId")
          option(value="") Sin grupo
          each grupo in grupos
            option(value=grupo.id)= grupo.nombre
 
      div.mb-3
        label.form-label Foto de perfil (opcional)
        input.form-control(type="file", name="foto", accept="image/*")
 
      button.btn.btn-success(type="submit") Crear Usuario
 
    hr
    table.table.table-striped.align-middle
      thead
        tr
          th Nombre
          th Usuario
          th Rol
          th Acciones
      tbody
        each u in usuarios
          tr
            td= u.nombre
            td= u.email
            td= u.rol
            td
              if u.rol !== 'admin'
                a.btn.btn-danger.btn-sm(href=`/admin/usuario/eliminar/${u.id}`) Eliminar
              else
                span.text-muted Principal