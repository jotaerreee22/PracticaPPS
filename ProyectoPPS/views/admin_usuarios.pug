doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Admin - Gestión de Usuarios
    link(rel="stylesheet", href="/stylesheets/style.css")
  body
    div.container
      nav
        div
          a(href="/admin/usuarios") 👥 Usuarios
          a(href="/admin/grupos") 🏢 Grupos
        a.btn-danger(href="/logout", style="padding: 5px 10px; color:white; border-radius:4px; text-decoration:none;") Cerrar Sesión

      h3 Formulario: Alta de Usuario
      form(action="/admin/usuario/alta", method="POST", enctype="multipart/form-data", style="margin-bottom: 40px;")
        div.form-group
          label Nombre Completo:
          input(type="text", name="nombre", required=true)
        div.form-group
          label Email:
          input(type="email", name="email", required=true)
        div.form-group
          label Contraseña:
          input(type="password", name="pass", required=true)
        div.form-group
          label Asignar Grupo:
          select(name="grupoId", required=true)
            option(value="") Selecciona un grupo...
            each grupo in grupos
              option(value=grupo.id) #{grupo.nombre}
        div.form-group
          label Foto de Perfil:
          input(type="file", name="foto", accept="image/*", required=true)
        button(type="submit") Registrar Usuario

      h3 Listado General de Usuarios
      table
        thead
          tr
            th Foto
            th Nombre
            th Email
            th Grupo ID
        tbody
          each user in usuarios
            if user.rol !== 'admin'
              tr
                td
                  img.avatar(src="/uploads/" + user.foto)
                td #{user.nombre}
                td #{user.email}
                td #{user.grupo}
