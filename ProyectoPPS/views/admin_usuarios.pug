extends layout

block content
  div.container.mt-4
    h2 Panel de Administración - Usuarios
    div.mb-3
      a.btn.btn-secondary.me-2(href="/admin/grupos") Ver Grupos
      a.btn.btn-danger(href="/logout") Cerrar Sesión

    hr

    h3 Lista de Usuarios
    table.table.table-striped.align-middle
      thead
        tr
          th Nombre
          th Usuario
          th Rol
          th Acciones
      tbody
        each u in usuarios
          tr
            td= u.nombre
            td= u.email
            td= u.rol
            td
              if u.rol !== 'admin'
                a.btn.btn-danger.btn-sm(href=`/admin/usuario/eliminar/${u.id}`) Eliminar
              else
                span.text-muted Principal