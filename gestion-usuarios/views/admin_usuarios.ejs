<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Admin - Gestión de Usuarios</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="container">
        <nav>
            <div>
                <a href="/admin/usuarios">👥 Usuarios</a>
                <a href="/admin/grupos">🏢 Grupos</a>
            </div>
            <a href="/logout" class="btn-danger" style="padding: 5px 10px; color:white; border-radius:4px; text-decoration:none;">Cerrar Sesión</a>
        </nav>

        <h3>Formulario: Alta de Usuario</h3>
        <form action="/admin/usuario/alta" method="POST" enctype="multipart/form-data" style="margin-bottom: 40px;">
            <div class="form-group">
                <label>Nombre Completo:</label>
                <input type="text" name="nombre" required>
            </div>
            <div class="form-group">
                <label>Email:</label>
                <input type="email" name="email" required>
            </div>
            <div class="form-group">
                <label>Contraseña:</label>
                <input type="password" name="pass" required>
            </div>
            <div class="form-group">
                <label>Asignar Grupo:</label>
                <select name="grupoId" required>
                    <option value="">Selecciona un grupo...</option>
                    <% grupos.forEach(grupo => { %>
                        <option value="<%= grupo.id %>"><%= grupo.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label>Foto de Perfil:</label>
                <input type="file" name="foto" accept="image/*" required>
            </div>
            <button type="submit">Registrar Usuario</button>
        </form>

        <h3>Listado General de Usuarios</h3>
        <table>
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Grupo ID</th>
                </tr>
            </thead>
            <tbody>
                <% usuarios.forEach(user => { %>
                    <% if(user.rol !== 'admin') { %>
                        <tr>
                            <td><img src="/uploads/<%= user.foto %>" class="avatar"></td>
                            <td><%= user.nombre %></td>
                            <td><%= user.email %></td>
                            <td><%= user.grupo %></td>
                        </tr>
                    <% } %>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
