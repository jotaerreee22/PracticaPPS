<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Usuario - Chat</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="container">
        <nav>
            <div class="user-row">
                <img src="/uploads/<%= usuario.foto %>" class="avatar" alt="Tu foto">
                <div>
                    <strong><%= usuario.nombre %></strong> 
                    <span style="color: #7f8c8d; font-size: 14px;">(Grupo ID: <%= usuario.grupo %>)</span>
                </div>
            </div>
            <a href="/logout" class="btn-danger" style="padding: 5px 10px; color:white; border-radius:4px; text-decoration:none;">Cerrar Sesión</a>
        </nav>

        <div class="layout-chat">
            <div class="sidebar">
                <h3>👥 Miembros del Grupo</h3>
                <p style="font-size: 12px; color: #7f8c8d; margin-bottom: 10px;">Solo ves usuarios de tu mismo grupo</p>
                <% compañeros.forEach(compañero => { %>
                    <div class="user-row">
                        <img src="/uploads/<%= compañero.foto %>" class="avatar">
                        <span><%= compañero.nombre %></span>
                    </div>
                <% }) %>
            </div>

            <div class="chat-main">
                <h3>💬 Historial de Mensajes</h3>
                <div class="chat-messages">
                    <% mensajes.forEach(msg => { %>
                        <div class="msg">
                            <strong><%= msg.remitenteNombre %>:</strong> <%= msg.texto %>
                        </div>
                    <% }) %>
                </div>

                <h3>✉️ Enviar Mensaje</h3>
                <form action="/mensaje/enviar" method="POST">
                    <div class="form-group">
                        <label>Destinatario (Compañero):</label>
                        <select name="destinatarioId" required>
                            <option value="">Selecciona a quién escribir...</option>
                            <% compañeros.forEach(compañero => { %>
                                <option value="<%= compañero.id %>"><%= compañero.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <textarea name="texto" rows="3" placeholder="Escribe un mensaje privado..." required></textarea>
                    </div>
                    <button type="submit">Enviar Mensaje</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
